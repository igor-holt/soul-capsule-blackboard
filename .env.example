# Placeholders only. Copy to .env locally. Never commit real secrets.
# These are for a possible future gc-mcp adapter. This draft does not
# call gc-mcp, a Notion bridge, or any remote Genesis Conductor gateway.
GC_API_KEY=
GC_GATEWAY_URL=
GC_NOTION_BRIDGE_URL=
GC_NOTION_BRIDGE_AUTH=
PORT=8788

# Host bind. Leave unset locally (127.0.0.1). Platforms that set PORT
# automatically bind 0.0.0.0. You can also set HOST=0.0.0.0 explicitly.
# HOST=0.0.0.0

# Seed two demo agents when the capsule log is empty (npm start always
# seeds if empty). Set to 0 only if you need a blank log for npm start.
# SEED_DEMO=1
